{
  "name": "dsh-dafeiyu",
  "version": "0.1.0-alpha.3",
  "private": true,
  "description": "大肥鱼：寄宿于 DeepSeek Harness Desktop 的个人 AI 实验插件，支持受限会话与手动启动的 B站单视频互动试验。真实能力以运行诊断和验收结果为准。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alice-Yuan/dsh-dafeiyu.git"
  },
  "homepage": "https://github.com/Alice-Yuan/dsh-dafeiyu#readme",
  "bugs": {
    "url": "https://github.com/Alice-Yuan/dsh-dafeiyu/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "exports": {
    ".": "./dist/host/plugin.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./policy": "./dist/host/policy.js",
    "./typert": "./dist/host/typert.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map",
    "README.md",
    "docs/desktop-install.md",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "tsc && tsc -p tsconfig.client.json && node scripts/build-client.mjs",
    "test": "node --test test/*.test.mjs",
    "demo": "node dist/demo.js",
    "preview": "node scripts/render-preview.mjs",
    "bundle:check": "node scripts/check-desktop-bundle.mjs",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.1.0",
    "esbuild": "0.25.12",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "5.9.3",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "zod": "4.4.3"
  },
  "dependencies": {
    "qrcode": "1.5.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "zod": "4.4.3"
  }
}
